{
  "name": "vfxt-functions",
  "version": "0.1.0",
  "private": true,
  "description": "VFXT platform Firebase Cloud Functions (2nd gen)",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "lint": "eslint src tests --max-warnings=0",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^10.3.1",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.18.0",
    "firebase": "^11.1.0",
    "firebase-functions-test": "^3.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
