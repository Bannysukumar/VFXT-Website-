{
  "name": "vfxt-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Hardhat + Solidity project for the VFXT (Virtual FX Trades) ERC-20 token",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.ts",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:bsc": "hardhat run scripts/deploy.ts --network bsc",
    "deploy:swap": "hardhat run scripts/deploy-swap.ts",
    "deploy:swap:bsc": "hardhat run scripts/deploy-swap.ts --network bsc",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.2.0",
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
