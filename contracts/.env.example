# Copy to .env and fill in values. NEVER commit .env or private keys.
# Put your private key ONLY in this local .env file — never paste it in chat or commit it.

# Deployer wallet private key (with or without 0x). Wallet must hold BNB for gas.
PRIVATE_KEY=

# BNB Smart Chain mainnet RPC (default public seed works; use your own if rate-limited)
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Sepolia JSON-RPC (optional, for testnet)
SEPOLIA_RPC_URL=

# Optional: BscScan API key for contract verification
BSCSCAN_API_KEY=

# Optional: Etherscan API key (Ethereum)
ETHERSCAN_API_KEY=

# Optional deploy overrides (used by scripts/deploy.ts)
# TREASURY_ADDRESS=0x...
# INITIAL_SUPPLY=1000000000
