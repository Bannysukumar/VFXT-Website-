# Copy to .env and fill in values. NEVER commit .env or private keys.
# Put your private key ONLY in this local .env file — never paste it in chat or commit it.

# Deployer wallet private key (with or without 0x). Wallet must hold BNB for gas.
PRIVATE_KEY=

# BNB Smart Chain mainnet RPC (default public seed works; use your own if rate-limited)
BSC_RPC_URL=https://bsc-dataseed.binance.org

# Sepolia JSON-RPC (optional, for testnet)
SEPOLIA_RPC_URL=

# Optional: BscScan API key for contract verification
BSCSCAN_API_KEY=

# Optional: Etherscan API key (Ethereum)
ETHERSCAN_API_KEY=

# Optional deploy overrides (used by scripts/deploy.ts)
# TREASURY_ADDRESS=0x...
# INITIAL_SUPPLY=10000000000000

# Optional VFXTSwap deploy settings (used by scripts/deploy-swap.ts)
# SWAP_ADMIN=0x...            # admin wallet that sets prices and moves liquidity (defaults to deployer)
# VFXT_ADDRESS=0x4A08EF10e6f4aa077A74496793467d2192061969
# USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# SWAP_BUY_PRICE=0.0001       # USDT per 1 VFXT when users buy ($0.0001)
# SWAP_SELL_PRICE=0.0001      # USDT per 1 VFXT when users sell (must be <= buy price)
