# Copy to .env and fill in values. NEVER commit .env or private keys.

# Deployer wallet private key (hex, no 0x prefix or with 0x — both usually work with ethers)
PRIVATE_KEY=

# Sepolia JSON-RPC endpoint (Alchemy, Infura, public RPC, etc.)
SEPOLIA_RPC_URL=

# Optional: Etherscan API key for contract verification
ETHERSCAN_API_KEY=

# Optional deploy overrides (used by scripts/deploy.ts)
# TREASURY_ADDRESS=0x...
# INITIAL_SUPPLY=1000000000
