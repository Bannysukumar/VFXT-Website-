###############################################################################
# VFXT Platform — Frontend Environment
# Copy to .env.local for local development. Never commit real secrets.
# Service accounts, private keys, and signing secrets belong in Firebase
# Secret Manager / Cloud Functions config — NEVER in frontend env vars.
###############################################################################

# Firebase Web App (public client config — still keep out of public repos if possible)
VITE_FIREBASE_API_KEY=your-api-key
# Production tip: after nginx proxies /__/auth to Firebase (see deploy/nginx-firebase-auth.conf),
# set this to virtualfxtrades.com so Auth stays same-origin on mobile Chrome.
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# App Check (use debug token locally; reCAPTCHA / Play Integrity in production)
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Use Firebase Emulator Suite locally
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
VITE_FIREBASE_FUNCTIONS_EMULATOR_HOST=127.0.0.1:5001
VITE_FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# Feature flags (client-visible; server remains authoritative)
VITE_FEATURE_STAKING_ENABLED=false
VITE_FEATURE_SWAPS_ENABLED=false
VITE_FEATURE_GAMING_ENABLED=false
VITE_FEATURE_BLOCKCHAIN_ENABLED=false

# Public token metadata (addresses validated server-side before enabling features)
VITE_VFXT_TOKEN_SYMBOL=VFXT
VITE_VFXT_TOKEN_DECIMALS=18
VITE_VFXT_CONTRACT_NAME=VFXT
VITE_VFXT_CHAIN_ID=56
VITE_VFXT_CONTRACT_ADDRESS=0x4A08EF10e6f4aa077A74496793467d2192061969
VITE_VFXT_TREASURY_ADDRESS=0x76b16F59Cfab5DdaE5D149BE98E5d755F939572A
VITE_VFXT_TOTAL_SUPPLY=10000000000000
VITE_VFXT_SWAP_ADDRESS=0xD0fe8d149D4Cb91Bc30036f8c0C799859C0A1F24

# Public contact address used by the /contact page form (opens the visitor's mail client)
VITE_SUPPORT_EMAIL=

# WalletConnect Cloud project id (https://cloud.walletconnect.com) — optional; enables WC QR modal
VITE_WALLETCONNECT_PROJECT_ID=da59a394854d46a9cc92bbe9668ae840
